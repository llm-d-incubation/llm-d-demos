apiVersion: apps/v1
kind: Deployment
metadata:
  name: llmd-gpu-decode
  labels:
    app: llmd-gpu-decode
    llm-d.ai/model: gemma-4-26b-a4b-gpu
    llm-d.ai/workload: one-shot
    llm-d.ai/accelerator-vendor: nvidia
spec:
  replicas: ${GPU_REPLICAS}
  # Oct 9: the GPU node is fully allocated to this pool, so a RollingUpdate can never schedule its surge pod and
  # deadlocks (seen when going 2 x TP=2 -> 4 x TP=1). Recreate = short pool downtime, deterministic.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: llmd-gpu-decode
      llm-d.ai/model: gemma-4-26b-a4b-gpu
  template:
    metadata:
      labels:
        app: llmd-gpu-decode
        llm-d.ai/model: gemma-4-26b-a4b-gpu
        llm-d.ai/workload: one-shot
        llm-d.ai/accelerator-vendor: nvidia
    spec:
      containers:
        - name: modelserver
          image: ${GPU_SERVING_IMAGE}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8000
              name: http
          args:
            - "--model=${MODEL_ID}"
            - "--served-model-name=${SERVED_MODEL_NAME}"
            - "--port=8000"
            - "--tensor-parallel-size=${GPU_TENSOR_PARALLEL_SIZE}"
            - "--enable-expert-parallel"
            - "--language-model-only"
            - "--disable-hybrid-kv-cache-manager"
            - "--limit-mm-per-prompt={\"image\":0,\"video\":0,\"audio\":0}"
            - "--hf-overrides={\"architectures\":[\"Gemma4ForCausalLM\"]}"
            - "--max-model-len=16384"
            - "--max-num-seqs=128"
            - "--gpu-memory-utilization=0.90"
            - "--trust-remote-code"
          env:
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: llm-d-hf-token
                  key: HF_TOKEN
                  optional: true
            - name: VLLM_LOGGING_LEVEL
              value: INFO
            - name: NCCL_MNNVL_ENABLE
              value: "0"
            - name: NCCL_NVLS_ENABLE
              value: "0"
            - name: NCCL_CUMEM_ENABLE
              value: "0"
            - name: NCCL_DEBUG
              value: WARN
          resources:
            limits:
              nvidia.com/gpu: "${GPU_TENSOR_PARALLEL_SIZE}"
            requests:
              nvidia.com/gpu: "${GPU_TENSOR_PARALLEL_SIZE}"
          volumeMounts:
            - name: dshm
              mountPath: /dev/shm
          startupProbe:
            httpGet:
              path: /health
              port: 8000
            initialDelaySeconds: 15
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet:
              path: /health
              port: 8000
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 3
      nodeSelector:
        cloud.google.com/gke-accelerator: ${GPU_ACCELERATOR_TYPE}
      tolerations:
        - key: nvidia.com/gpu
          operator: Exists
          effect: NoSchedule
        - key: cloud.google.com/gke-spot
          operator: Exists
          effect: NoSchedule
        # A4X (GB200) nodes are ARM64 (Grace CPU); GKE taints them kubernetes.io/arch=arm64:NoSchedule.
        # vllm/vllm-openai is multi-arch, so tolerating this is safe on x86 pools too.
        - key: kubernetes.io/arch
          operator: Equal
          value: arm64
          effect: NoSchedule
      volumes:
        - name: dshm
          emptyDir:
            medium: Memory
---
apiVersion: v1
kind: Service
metadata:
  name: llmd-gpu-service
  labels:
    llm-d.ai/workload: one-shot
spec:
  selector:
    app: llmd-gpu-decode
  ports:
    - name: http
      port: 8000
      targetPort: 8000

# Scale-out replicas for the shared-storage KV tier, deployed by scripts/62_deploy_kv_storage_replicas.sh.
# Same model and image as the GPU pool, kept out of the InferencePool (different app label) so the
# router and the live A/B are untouched. Small HBM cap and host pool on purpose: a returning
# session is served from the Lustre tier, which is what the dashboard's Tier 3 panel shows.
# Variables: ${KV_STORAGE_REPLICAS} ${GPU_SERVING_IMAGE} ${MODEL_ID} ${SERVED_MODEL_NAME}
#   ${GPU_ACCELERATOR_TYPE} ${KV_STORAGE_REPLICA_HBM_CAP_BYTES} ${KV_STORAGE_REPLICA_MEMORY}
#   ${KV_STORAGE_REPLICA_DSHM_SIZE} ${KV_STORAGE_TRANSFER_CONFIG_JSON} ${KV_STORAGE_MOUNT_PATH} ${KV_STORAGE_PVC}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: llmd-gpu-storage
  labels:
    app: llmd-gpu-storage
    llm-d.ai/model: gemma-4-26b-a4b-gpu
    llm-d.ai/workload: scale-out
    llm-d.ai/accelerator-vendor: nvidia
spec:
  replicas: ${KV_STORAGE_REPLICAS}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: llmd-gpu-storage
  template:
    metadata:
      labels:
        app: llmd-gpu-storage
        llm-d.ai/model: gemma-4-26b-a4b-gpu
        llm-d.ai/workload: scale-out
        llm-d.ai/accelerator-vendor: nvidia
    spec:
      containers:
        - name: modelserver
          image: ${GPU_SERVING_IMAGE}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8000
              name: http
          args:
            - "--model=${MODEL_ID}"
            - "--served-model-name=${SERVED_MODEL_NAME}"
            - "--port=8000"
            - "--tensor-parallel-size=1"
            - "--enable-expert-parallel"
            - "--language-model-only"
            - "--no-disable-hybrid-kv-cache-manager"
            - "--limit-mm-per-prompt={\"image\":0,\"video\":0,\"audio\":0}"
            - "--hf-overrides={\"architectures\":[\"Gemma4ForCausalLM\"]}"
            - "--max-model-len=16384"
            - "--max-num-seqs=128"
            - "--gpu-memory-utilization=0.90"
            - "--trust-remote-code"
            - "--kv-cache-memory-bytes=${KV_STORAGE_REPLICA_HBM_CAP_BYTES}"
            - '--kv-transfer-config=${KV_STORAGE_TRANSFER_CONFIG_JSON}'
          env:
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: llm-d-hf-token
                  key: HF_TOKEN
                  optional: true
            - name: VLLM_LOGGING_LEVEL
              value: INFO
            # Same block hashes as the GPU pool, so chunks written by any replica are found by the others.
            - name: PYTHONHASHSEED
              value: "42"
            - name: NCCL_MNNVL_ENABLE
              value: "0"
            - name: NCCL_NVLS_ENABLE
              value: "0"
            - name: NCCL_CUMEM_ENABLE
              value: "0"
            - name: NCCL_DEBUG
              value: WARN
          resources:
            limits:
              nvidia.com/gpu: "1"
              memory: ${KV_STORAGE_REPLICA_MEMORY}
            requests:
              nvidia.com/gpu: "1"
              memory: ${KV_STORAGE_REPLICA_MEMORY}
          volumeMounts:
            - name: dshm
              mountPath: /dev/shm
            - name: kv-storage
              mountPath: ${KV_STORAGE_MOUNT_PATH}
          startupProbe:
            httpGet:
              path: /health
              port: 8000
            initialDelaySeconds: 15
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet:
              path: /health
              port: 8000
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 3
      nodeSelector:
        cloud.google.com/gke-accelerator: ${GPU_ACCELERATOR_TYPE}
      tolerations:
        - key: nvidia.com/gpu
          operator: Exists
          effect: NoSchedule
        - key: cloud.google.com/gke-spot
          operator: Exists
          effect: NoSchedule
        - key: kubernetes.io/arch
          operator: Equal
          value: arm64
          effect: NoSchedule
      volumes:
        - name: dshm
          emptyDir:
            medium: Memory
            sizeLimit: ${KV_STORAGE_REPLICA_DSHM_SIZE}
        - name: kv-storage
          persistentVolumeClaim:
            claimName: ${KV_STORAGE_PVC}
---
# Round-robin entry point for the dashboard's storage ring (each turn lands on another replica).
apiVersion: v1
kind: Service
metadata:
  name: llmd-gpu-storage-service
  labels:
    llm-d.ai/workload: scale-out
spec:
  selector:
    app: llmd-gpu-storage
  ports:
    - name: http
      port: 8000
      targetPort: 8000
---
# Headless Service: one DNS A record per replica, for the dashboard's per-pod /metrics scrape.
apiVersion: v1
kind: Service
metadata:
  name: llmd-gpu-storage-pods
  labels:
    llm-d.ai/workload: scale-out
spec:
  clusterIP: None
  publishNotReadyAddresses: false
  selector:
    app: llmd-gpu-storage
  ports:
    - name: http
      port: 8000
      targetPort: 8000

# Headless Services for the dashboard's per-pod vLLM /metrics scrape (KV-cache hit rate).
# clusterIP: None => DNS A records = the pod IPs, so abbench.py can scrape every pod of a pool
# individually. Scraping through the regular ClusterIP Service lands on a random pod per request,
# which made the counter deltas meaningless (e.g. "156 %" on 2026-10-08).
# Rendered by scripts/86_deploy_dashboard_image.sh via envsubst: ${NAMESPACE} ${GPU_NAMESPACE}
apiVersion: v1
kind: Service
metadata:
  name: llmd-tpu-pods
  namespace: ${NAMESPACE}
  labels:
    app: llmd-live-dashboard
spec:
  clusterIP: None
  publishNotReadyAddresses: false
  selector:
    app: llmd-tpu-decode
  ports:
    - name: http
      port: 8000
      targetPort: 8000
---
apiVersion: v1
kind: Service
metadata:
  name: llmd-gpu-pods
  namespace: ${GPU_NAMESPACE}
  labels:
    app: llmd-live-dashboard
spec:
  clusterIP: None
  publishNotReadyAddresses: false
  selector:
    app: llmd-gpu-decode
  ports:
    - name: http
      port: 8000
      targetPort: 8000
